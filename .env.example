# Copy to .env.local for local dev. Never commit .env.local.
# Values come from the accounts you set up in 03-build/setup.md.

# Supabase (Project Settings > API)
NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...
SUPABASE_SERVICE_ROLE_KEY=eyJ...   # server only, never NEXT_PUBLIC_

# Stripe (Developers > API keys, test mode)
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...   # from `stripe listen` locally, or the Render endpoint

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000
