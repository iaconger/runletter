# Copy to .env.local for local dev. Never commit .env.local.
# Values come from the accounts you set up in 03-build/setup.md.

# Supabase (Project Settings > API)
NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...
SUPABASE_SERVICE_ROLE_KEY=eyJ...   # server only, never NEXT_PUBLIC_

# Stripe (Developers > API keys, test mode)
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...   # from `stripe listen` locally, or the Render endpoint
STRIPE_CONNECT_WEBHOOK_SECRET=whsec_...   # second endpoint: events on connected accounts (account.updated)
PLATFORM_FEE_PERCENT=20            # RunLetter's take on every payment; per-creator override in profiles.platform_fee_pct

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Strava (strava.com/settings/api). Callback domain = your app host. Webhook needs a public URL.
STRAVA_CLIENT_ID=
STRAVA_CLIENT_SECRET=
STRAVA_VERIFY_TOKEN=any-random-string   # you choose it; Strava echoes it on the webhook handshake

# Garmin Connect Developer Program (Training API). Leave blank until approved; the queue waits.
GARMIN_CONSUMER_KEY=
GARMIN_CONSUMER_SECRET=

# Sync worker. A Render cron POSTs /api/sync with this header every 10 minutes.
SYNC_SECRET=

# PostHog (posthog.com → project settings). Unset = analytics off.
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# Shoe product images (optional). Until these exist the app draws the shoe instead.
# AvantLink: apply at avantlink.com/publishers, then get approved by each retailer (Running Warehouse etc).
AVANTLINK_AFFILIATE_ID=
AVANTLINK_API_KEY=
AVANTLINK_MERCHANT_IDS=        # comma separated, optional: restricts the search to retailers you are approved with
