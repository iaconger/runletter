{
  "$schema": "https://design-tokens.github.io/community-group/format/",
  "$description": "RunLetter design tokens. Source of truth. Editorial direction, Sept 2026. Built from scratch for RunLetter; nothing shared with any other system.",
  "color": {
    "primitive": {
      "paper-50": {
        "$type": "color",
        "$value": "#FCFAF6"
      },
      "paper-100": {
        "$type": "color",
        "$value": "#F7F4EE"
      },
      "paper-200": {
        "$type": "color",
        "$value": "#F0ECE4"
      },
      "paper-300": {
        "$type": "color",
        "$value": "#E3DED4"
      },
      "stone-500": {
        "$type": "color",
        "$value": "#9A948A"
      },
      "stone-600": {
        "$type": "color",
        "$value": "#6F6A62"
      },
      "stone-700": {
        "$type": "color",
        "$value": "#4A4741"
      },
      "ink-800": {
        "$type": "color",
        "$value": "#2E2B27"
      },
      "ink-850": {
        "$type": "color",
        "$value": "#1E1C19"
      },
      "ink-900": {
        "$type": "color",
        "$value": "#141311"
      },
      "cobalt-100": {
        "$type": "color",
        "$value": "#E3E8FB"
      },
      "cobalt-400": {
        "$type": "color",
        "$value": "#7C93FF"
      },
      "cobalt-500": {
        "$type": "color",
        "$value": "#3B5BFF"
      },
      "cobalt-600": {
        "$type": "color",
        "$value": "#2540C8"
      },
      "cobalt-700": {
        "$type": "color",
        "$value": "#1C33A6"
      },
      "moss-500": {
        "$type": "color",
        "$value": "#2F7D4A"
      },
      "moss-600": {
        "$type": "color",
        "$value": "#256A3D"
      },
      "moss-100": {
        "$type": "color",
        "$value": "#DDEDE2"
      }
    },
    "light": {
      "bg": {
        "$type": "color",
        "$value": "{color.primitive.paper-100}",
        "$description": "Page background"
      },
      "surface": {
        "$type": "color",
        "$value": "{color.primitive.paper-50}",
        "$description": "Cards, sheets, inputs"
      },
      "surface-sunken": {
        "$type": "color",
        "$value": "{color.primitive.paper-200}",
        "$description": "Rest days, disabled, secondary fills"
      },
      "hairline": {
        "$type": "color",
        "$value": "{color.primitive.paper-300}",
        "$description": "1px dividers and borders. Never shadows."
      },
      "text": {
        "$type": "color",
        "$value": "{color.primitive.ink-900}"
      },
      "text-secondary": {
        "$type": "color",
        "$value": "{color.primitive.stone-700}"
      },
      "text-muted": {
        "$type": "color",
        "$value": "{color.primitive.stone-600}",
        "$description": "AA on bg (4.9:1). Minimum for readable text."
      },
      "text-disabled": {
        "$type": "color",
        "$value": "{color.primitive.stone-500}",
        "$description": "Not AA. Disabled and decorative only."
      },
      "accent": {
        "$type": "color",
        "$value": "{color.primitive.cobalt-600}",
        "$description": "Links, focus, the one highlight. AA on bg (7.2:1)."
      },
      "accent-bright": {
        "$type": "color",
        "$value": "{color.primitive.cobalt-500}",
        "$description": "Large graphics only: block bars, progress. Not for text under 24px."
      },
      "accent-soft": {
        "$type": "color",
        "$value": "{color.primitive.cobalt-100}",
        "$description": "Tint behind accent content"
      },
      "on-accent": {
        "$type": "color",
        "$value": "{color.primitive.paper-100}"
      },
      "on-accent-soft": {
        "$type": "color",
        "$value": "{color.primitive.cobalt-700}",
        "$description": "Text on accent-soft. 8.3:1"
      },
      "primary": {
        "$type": "color",
        "$value": "{color.primitive.ink-900}",
        "$description": "Primary button fill. Ink, not accent."
      },
      "on-primary": {
        "$type": "color",
        "$value": "{color.primitive.paper-100}"
      },
      "success": {
        "$type": "color",
        "$value": "{color.primitive.moss-500}",
        "$description": "Completed run, Strava synced"
      },
      "success-soft": {
        "$type": "color",
        "$value": "{color.primitive.moss-100}"
      },
      "on-success-soft": {
        "$type": "color",
        "$value": "{color.primitive.moss-600}",
        "$description": "Text on success-soft. 5.4:1"
      },
      "focus": {
        "$type": "color",
        "$value": "{color.primitive.cobalt-600}"
      }
    },
    "dark": {
      "bg": {
        "$type": "color",
        "$value": "{color.primitive.ink-900}"
      },
      "surface": {
        "$type": "color",
        "$value": "{color.primitive.ink-850}"
      },
      "surface-sunken": {
        "$type": "color",
        "$value": "{color.primitive.ink-800}"
      },
      "hairline": {
        "$type": "color",
        "$value": "{color.primitive.ink-800}"
      },
      "text": {
        "$type": "color",
        "$value": "{color.primitive.paper-100}"
      },
      "text-secondary": {
        "$type": "color",
        "$value": "{color.primitive.paper-300}"
      },
      "text-muted": {
        "$type": "color",
        "$value": "{color.primitive.stone-500}"
      },
      "text-disabled": {
        "$type": "color",
        "$value": "{color.primitive.stone-600}"
      },
      "accent": {
        "$type": "color",
        "$value": "{color.primitive.cobalt-400}"
      },
      "accent-bright": {
        "$type": "color",
        "$value": "{color.primitive.cobalt-500}"
      },
      "accent-soft": {
        "$type": "color",
        "$value": "#1B2140"
      },
      "on-accent": {
        "$type": "color",
        "$value": "{color.primitive.ink-900}"
      },
      "on-accent-soft": {
        "$type": "color",
        "$value": "{color.primitive.cobalt-400}"
      },
      "primary": {
        "$type": "color",
        "$value": "{color.primitive.paper-100}"
      },
      "on-primary": {
        "$type": "color",
        "$value": "{color.primitive.ink-900}"
      },
      "success": {
        "$type": "color",
        "$value": "#5FB57E"
      },
      "success-soft": {
        "$type": "color",
        "$value": "#1E3327"
      },
      "on-success-soft": {
        "$type": "color",
        "$value": "#5FB57E"
      },
      "focus": {
        "$type": "color",
        "$value": "{color.primitive.cobalt-400}"
      }
    }
  },
  "font": {
    "family": {
      "display": {
        "$type": "fontFamily",
        "$value": [
          "Instrument Serif",
          "Georgia",
          "serif"
        ],
        "$description": "Program titles, day headings, the creator's note. Never for UI controls or numbers."
      },
      "sans": {
        "$type": "fontFamily",
        "$value": [
          "Geist",
          "Inter",
          "system-ui",
          "sans-serif"
        ],
        "$description": "Everything else. Tabular numerals on by default."
      }
    },
    "weight": {
      "regular": {
        "$type": "fontWeight",
        "$value": 400
      },
      "medium": {
        "$type": "fontWeight",
        "$value": 500
      },
      "semibold": {
        "$type": "fontWeight",
        "$value": 600
      }
    },
    "size": {
      "display-xl": {
        "$type": "dimension",
        "$value": "44px"
      },
      "display-lg": {
        "$type": "dimension",
        "$value": "32px"
      },
      "title": {
        "$type": "dimension",
        "$value": "24px"
      },
      "heading": {
        "$type": "dimension",
        "$value": "18px"
      },
      "body": {
        "$type": "dimension",
        "$value": "16px"
      },
      "body-sm": {
        "$type": "dimension",
        "$value": "14px"
      },
      "label": {
        "$type": "dimension",
        "$value": "12px"
      },
      "numeral-xl": {
        "$type": "dimension",
        "$value": "56px"
      },
      "numeral-lg": {
        "$type": "dimension",
        "$value": "32px"
      }
    },
    "lineHeight": {
      "display-xl": {
        "$type": "dimension",
        "$value": "48px"
      },
      "display-lg": {
        "$type": "dimension",
        "$value": "36px"
      },
      "title": {
        "$type": "dimension",
        "$value": "28px"
      },
      "heading": {
        "$type": "dimension",
        "$value": "24px"
      },
      "body": {
        "$type": "dimension",
        "$value": "24px"
      },
      "body-sm": {
        "$type": "dimension",
        "$value": "20px"
      },
      "label": {
        "$type": "dimension",
        "$value": "16px"
      },
      "numeral-xl": {
        "$type": "dimension",
        "$value": "56px"
      },
      "numeral-lg": {
        "$type": "dimension",
        "$value": "36px"
      }
    },
    "letterSpacing": {
      "display": {
        "$type": "dimension",
        "$value": "-0.01em"
      },
      "label": {
        "$type": "dimension",
        "$value": "0.08em",
        "$description": "Uppercase eyebrow labels only"
      },
      "numeral": {
        "$type": "dimension",
        "$value": "-0.02em"
      }
    }
  },
  "typography": {
    "display-xl": {
      "$type": "typography",
      "$value": {
        "fontFamily": "{font.family.display}",
        "fontSize": "{font.size.display-xl}",
        "lineHeight": "{font.lineHeight.display-xl}",
        "fontWeight": "{font.weight.regular}",
        "letterSpacing": "{font.letterSpacing.display}"
      },
      "$description": "Program page hero title"
    },
    "display-lg": {
      "$type": "typography",
      "$value": {
        "fontFamily": "{font.family.display}",
        "fontSize": "{font.size.display-lg}",
        "lineHeight": "{font.lineHeight.display-lg}",
        "fontWeight": "{font.weight.regular}",
        "letterSpacing": "{font.letterSpacing.display}"
      },
      "$description": "Today screen run name, creator name"
    },
    "title": {
      "$type": "typography",
      "$value": {
        "fontFamily": "{font.family.display}",
        "fontSize": "{font.size.title}",
        "lineHeight": "{font.lineHeight.title}",
        "fontWeight": "{font.weight.regular}"
      },
      "$description": "Card titles, section titles, the creator's note"
    },
    "heading": {
      "$type": "typography",
      "$value": {
        "fontFamily": "{font.family.sans}",
        "fontSize": "{font.size.heading}",
        "lineHeight": "{font.lineHeight.heading}",
        "fontWeight": "{font.weight.semibold}"
      }
    },
    "body": {
      "$type": "typography",
      "$value": {
        "fontFamily": "{font.family.sans}",
        "fontSize": "{font.size.body}",
        "lineHeight": "{font.lineHeight.body}",
        "fontWeight": "{font.weight.regular}"
      }
    },
    "body-medium": {
      "$type": "typography",
      "$value": {
        "fontFamily": "{font.family.sans}",
        "fontSize": "{font.size.body}",
        "lineHeight": "{font.lineHeight.body}",
        "fontWeight": "{font.weight.medium}"
      },
      "$description": "Buttons, list titles"
    },
    "body-sm": {
      "$type": "typography",
      "$value": {
        "fontFamily": "{font.family.sans}",
        "fontSize": "{font.size.body-sm}",
        "lineHeight": "{font.lineHeight.body-sm}",
        "fontWeight": "{font.weight.regular}"
      }
    },
    "label": {
      "$type": "typography",
      "$value": {
        "fontFamily": "{font.family.sans}",
        "fontSize": "{font.size.label}",
        "lineHeight": "{font.lineHeight.label}",
        "fontWeight": "{font.weight.medium}",
        "letterSpacing": "{font.letterSpacing.label}",
        "textCase": "uppercase"
      },
      "$description": "Eyebrows: THURSDAY, TEMPO, WEEK 3"
    },
    "numeral-xl": {
      "$type": "typography",
      "$value": {
        "fontFamily": "{font.family.sans}",
        "fontSize": "{font.size.numeral-xl}",
        "lineHeight": "{font.lineHeight.numeral-xl}",
        "fontWeight": "{font.weight.medium}",
        "letterSpacing": "{font.letterSpacing.numeral}",
        "fontFeatures": "tnum"
      },
      "$description": "Duration and distance on Today. Tabular."
    },
    "numeral-lg": {
      "$type": "typography",
      "$value": {
        "fontFamily": "{font.family.sans}",
        "fontSize": "{font.size.numeral-lg}",
        "lineHeight": "{font.lineHeight.numeral-lg}",
        "fontWeight": "{font.weight.medium}",
        "letterSpacing": "{font.letterSpacing.numeral}",
        "fontFeatures": "tnum"
      }
    }
  },
  "space": {
    "1": {
      "$type": "dimension",
      "$value": "4px"
    },
    "2": {
      "$type": "dimension",
      "$value": "8px"
    },
    "3": {
      "$type": "dimension",
      "$value": "12px"
    },
    "4": {
      "$type": "dimension",
      "$value": "16px"
    },
    "5": {
      "$type": "dimension",
      "$value": "20px"
    },
    "6": {
      "$type": "dimension",
      "$value": "24px"
    },
    "8": {
      "$type": "dimension",
      "$value": "32px"
    },
    "10": {
      "$type": "dimension",
      "$value": "40px"
    },
    "12": {
      "$type": "dimension",
      "$value": "48px"
    },
    "16": {
      "$type": "dimension",
      "$value": "64px"
    }
  },
  "radius": {
    "sm": {
      "$type": "dimension",
      "$value": "4px",
      "$description": "Chips, block segments"
    },
    "md": {
      "$type": "dimension",
      "$value": "8px",
      "$description": "Buttons, inputs"
    },
    "lg": {
      "$type": "dimension",
      "$value": "12px",
      "$description": "Cards"
    },
    "pill": {
      "$type": "dimension",
      "$value": "999px"
    }
  },
  "border": {
    "hairline": {
      "$type": "dimension",
      "$value": "1px"
    },
    "focus": {
      "$type": "dimension",
      "$value": "2px"
    }
  },
  "elevation": {
    "none": {
      "$type": "shadow",
      "$value": "none",
      "$description": "Default. Hairlines separate surfaces, not shadows."
    },
    "overlay": {
      "$type": "shadow",
      "$value": {
        "offsetX": "0",
        "offsetY": "8px",
        "blur": "24px",
        "spread": "0",
        "color": "rgba(20,19,17,0.12)"
      },
      "$description": "Sheets and menus only"
    }
  },
  "motion": {
    "duration-fast": {
      "$type": "duration",
      "$value": "150ms"
    },
    "duration-base": {
      "$type": "duration",
      "$value": "250ms"
    },
    "easing": {
      "$type": "cubicBezier",
      "$value": [
        0.2,
        0,
        0,
        1
      ]
    }
  },
  "size": {
    "control-sm": {
      "$type": "dimension",
      "$value": "36px"
    },
    "control-md": {
      "$type": "dimension",
      "$value": "44px",
      "$description": "Default touch target"
    },
    "control-lg": {
      "$type": "dimension",
      "$value": "52px",
      "$description": "Primary action on Today"
    },
    "icon": {
      "$type": "dimension",
      "$value": "20px"
    },
    "content-max": {
      "$type": "dimension",
      "$value": "640px",
      "$description": "Reading width for follower app and program pages"
    }
  },
  "breakpoint": {
    "sm": {
      "$type": "dimension",
      "$value": "640px"
    },
    "md": {
      "$type": "dimension",
      "$value": "900px"
    },
    "lg": {
      "$type": "dimension",
      "$value": "1200px"
    }
  },
  "atmosphere": {
    "$description": "Grainy gradient grounds for marketing, hero areas, the app icon splash, and share cards. Never behind body text in the app. Two named atmospheres plus the grain overlay. CSS strings are the reference implementation; SVGs in atmosphere/ are the exportable versions.",
    "grain": {
      "$type": "string",
      "$value": "url(\"data:image/svg+xml,%3Csvg%20xmlns%3D%22http%3A//www.w3.org/2000/svg%22%20width%3D%22240%22%20height%3D%22240%22%3E%3Cfilter%20id%3D%22g%22%3E%3CfeTurbulence%20type%3D%22fractalNoise%22%20baseFrequency%3D%220.9%22%20numOctaves%3D%222%22%20stitchTiles%3D%22stitch%22/%3E%3CfeColorMatrix%20type%3D%22saturate%22%20values%3D%220%22/%3E%3C/filter%3E%3Crect%20width%3D%22100%25%22%20height%3D%22100%25%22%20filter%3D%22url%28%23g%29%22/%3E%3C/svg%3E\")",
      "$description": "Tile as a repeating background-image on a layer with mix-blend-mode: overlay and opacity .18 (light) or .28 (dark)."
    },
    "night": {
      "$type": "string",
      "$value": "radial-gradient(60% 70% at 18% 88%, rgba(59,91,255,.55) 0%, rgba(59,91,255,0) 60%), radial-gradient(45% 55% at 85% 12%, rgba(247,244,238,.14) 0%, rgba(247,244,238,0) 60%), linear-gradient(160deg, #1E1C19 0%, #141311 55%, #0E0D0C 100%)",
      "$description": "Ink base, cobalt glow bottom-left, faint paper glow top-right. Use with paper text. Marketing and dark hero."
    },
    "dawn": {
      "$type": "string",
      "$value": "radial-gradient(55% 65% at 80% 20%, rgba(59,91,255,.22) 0%, rgba(59,91,255,0) 60%), radial-gradient(50% 60% at 10% 90%, rgba(227,232,251,.9) 0%, rgba(227,232,251,0) 60%), linear-gradient(160deg, #FCFAF6 0%, #F7F4EE 60%, #F0ECE4 100%)",
      "$description": "Paper base, cobalt haze top-right, cobalt-100 pool bottom-left. Use with ink text. Light hero, program page cover fallback."
    }
  }
}